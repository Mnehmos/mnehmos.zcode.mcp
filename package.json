{
  "name": "mnehmos.zcode.mcp",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mnehmos-zcode-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run typecheck && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:only": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:it": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=integration",
    "smoke": "node dist/index.js --self-test",
    "start:env": "node --env-file=.env dist/index.js",
    "scan:secrets": "python tools/scan_secrets.py",
    "scan:staged": "python tools/scan_secrets.py --staged"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zcode",
    "z-ai",
    "zhipu",
    "agent-control",
    "reverse-engineering",
    "spec-driven"
  ],
  "author": "Mnehmos",
  "license": "MIT",
  "description": "MCP server exposing ZCode's agent runtime as a bounded semantic control surface. Owns a ZCode agent process per workspace and speaks the ZCode Protocol over stdio; every mutation is read back before it is reported, and two capabilities a bare runtime cannot provide are declared rather than faked.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mnehmos/mnehmos.zcode.mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
