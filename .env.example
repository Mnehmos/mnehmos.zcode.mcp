# mnehmos.zcode.mcp — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, and must never
# contain a real credential.
#
# Loading is explicit, never automatic — a server that silently reads a file next to itself
# is a surprise nobody wants from something holding credentials:
#
#     npm run start:env          # node --env-file=.env dist/index.js
#     node --env-file=.env dist/index.js
#
# Most MCP clients instead inject env through their own config block, which is equally fine.

# ── the provider the spawned runtime uses ─────────────────────────────────────
# Delivered to the child as ZCODE_MODEL / ZCODE_BASE_URL. Required: without a model
# provider a spawned runtime reports `missing-model` and session/create refuses with
# "Model config is missing".
#
# "<model>" or "<provider>/<model>". The provider part selects WHICH credential is used,
# so with several keys below, naming the provider is what picks the right one.
ZCODE_MCP_MODEL=deepseek/deepseek-v4-flash

# The Anthropic-format base URL for that provider. NOTE: this variable is read by TWO
# subsystems — as the model base URL, and by ZCode's endpoint resolver as the
# control-plane origin (OAuth/plan/telemetry). Unused for a local agent runtime, but do
# not point it at an endpoint you would not also accept as the API origin.
ZCODE_MCP_BASE_URL=https://api.deepseek.com/anthropic

# ── credentials ───────────────────────────────────────────────────────────────
# The server resolves the key for the provider named above and passes ONLY that one to
# the child. Every other credential-shaped variable is withheld from spawned runtimes.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# ── workspace ─────────────────────────────────────────────────────────────────
# Default workspace when a tool call omits one.
ZCODE_MCP_WORKSPACE=

# ── authority ─────────────────────────────────────────────────────────────────
# deny | allow | ask. Default deny: an MCP server does not silently acquire the approvals
# a human would have been asked for.
ZCODE_MCP_APPROVAL=deny
# Patterns using the CLI's own syntax: `Tool` or `Tool(prefix*)`, comma-separated.
# ZCODE_MCP_APPROVAL_ALLOWLIST=Read,Glob,Grep,Bash(git *)
ZCODE_MCP_DEFAULT_MODE=edit
# Persisting a durable permission rule changes FUTURE authority; gated separately.
# ZCODE_MCP_ALLOW_PERSIST_RULES=1

# ── guard flags (all off by default) ──────────────────────────────────────────
# ZCODE_MCP_ALLOW_PROVIDER_EDIT=1
# ZCODE_MCP_ALLOW_PLUGIN_INSTALL=1
# ZCODE_MCP_ALLOW_MCP_CONFIG_EDIT=1
# ZCODE_MCP_DISABLE_PROTOCOL=1
# ZCODE_MCP_PROTOCOL_ALLOW_MUTATIONS=1

# ── runtime ───────────────────────────────────────────────────────────────────
ZCODE_MCP_MAX_CHILDREN=2
ZCODE_MCP_TIMEOUT_MS=180000
ZCODE_MCP_REDACT=1

# Re-admit specific variables to a spawned runtime, by name. By default every
# credential-shaped variable is withheld, so an agent's shell never inherits a credential
# it was not given. Name one here when it genuinely needs it.
# ZCODE_MCP_CHILD_ENV_PASSTHROUGH=GITHUB_TOKEN

# ── model catalogue ───────────────────────────────────────────────────────────
# The selection tool prefers the installed ZCode's own catalogue and falls back to the
# vendored data/model_catalog.json. Override to pin one:
# ZCODE_MCP_MODEL_CATALOG=
